# ==============================================================================
# ChitFlow Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with secure credentials.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# --- Application Runtime Environment ---
# Options: development, test, staging, production
# In production, demo accounts are automatically suppressed and SECRET_KEY is enforced.
ENVIRONMENT=development

# --- Cryptographic Security ---
# Mandatory in production: must be a high-entropy string of at least 32 characters.
# Generate on Unix/macOS: `openssl rand -hex 32`
# Generate on Windows PowerShell: `[Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))`
SECRET_KEY=your_cryptographically_secure_256bit_secret_key_here

# JWT token expiration time in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Connection ---
# Local Development (SQLite):
DATABASE_URL=sqlite:///./chitflow.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://chitflow_admin:STRONG_PASSWORD_HERE@localhost:5432/chitflow_prod

# --- Security & Seeding Controls ---
# Set to 'true' ONLY in local development/testing to seed mock demo accounts.
# MUST be 'false' in production.
ALLOW_DEMO_SEEDING=false

# --- CORS Allowed Origins ---
# Comma-separated list of permitted frontend client origins.
# Wildcard '*' is strictly prohibited when allow_credentials=True in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- External Services (Phase 2B Future Integrations) ---
# SMS / OTP Gateway configuration (kept unconfigured until production SMS provider is integrated)
SMS_GATEWAY_PROVIDER=unconfigured
SMS_GATEWAY_API_KEY=

# Cloud Storage for receipts and KYC documents (GCS or S3)
STORAGE_BUCKET_NAME=
STORAGE_REGION=

# --- Frontend Client Configuration ---
# API endpoint for the React frontend application
VITE_API_URL=http://localhost:8000/api/v1

