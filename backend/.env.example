# ChitFlow Backend Environment Configuration Template
# Copy to backend/.env and populate with deployment-specific credentials.

ENVIRONMENT=development
SECRET_KEY=your_cryptographically_secure_256bit_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./chitflow.db
ALLOW_DEMO_SEEDING=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SMS_GATEWAY_PROVIDER=unconfigured
SMS_GATEWAY_API_KEY=

